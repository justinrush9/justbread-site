{
  "version": 2,
  "crons": [
    {
      "path": "/api/reconcile?days=2",
      "schedule": "0 13 * * *"
    }
  ],
  "functions": {
    "api/admin.js": {
      "includeFiles": "db/schema.sql"
    }
  },
  "rewrites": [
    {
      "source": "/api/(bake-sheet|login|migrate|move-to-monday|order-edit|orders|production|standing-orders|stops|subscription-control|route)",
      "destination": "/api/admin?route=$1"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "stripe-test-results": false
    }
  }
}
